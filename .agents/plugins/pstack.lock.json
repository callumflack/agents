{
  "repository": "https://github.com/cursor/plugins",
  "subpath": "pstack",
  "revision": "0b46ec399d55f2829e88822998f53b84944837d3",
  "version": "0.15.46",
  "install": {
    "cursor": "/add-plugin pstack",
    "codex": {
      "namespace": "pstack",
      "management": "personal-marketplace",
      "marketplace": {
        "name": "personal",
        "root": "~",
        "manifest": "~/.agents/plugins/marketplace.json",
        "sourcePath": "./plugins/pstack"
      },
      "runtimePath": "~/plugins/pstack",
      "adaptation": [
        "Copy the upstream skills into a local Codex plugin at ~/plugins/pstack.",
        "Translate .cursor-plugin/plugin.json to .codex-plugin/plugin.json.",
        "Remove disable-model-invocation from skill frontmatter.",
        "Register the adapted plugin with Codex so its skills load as pstack:<skill>.",
        "Use pstack-codex for Codex task, model, and session-mode translation."
      ],
      "compatibilitySkill": "pstack-codex",
      "sessionModeSetup": "python3 ~/.agents/skills/pstack-codex/scripts/poteto-session-mode.py install",
      "preflight": [
        "codex plugin marketplace list",
        "codex plugin list"
      ],
      "verification": [
        "python3 ~/Repos/callumflack/skills/pstack-codex/scripts/test-poteto-session-mode.py",
        "mise run skills:check",
        "Confirm a fresh Codex task exposes Pstack skills as pstack:<skill>.",
        "Confirm .agents/.skill-lock.json contains no Pstack skills and keeps the recorded bare-name owners."
      ]
    },
    "claude": {
      "pluginId": "pstack@personal",
      "scope": "user",
      "observedVersion": "0.15.46",
      "marketplace": {
        "name": "personal",
        "root": "~/Repos/callumflack/agents",
        "manifest": ".claude-plugin/marketplace.json",
        "sourcePath": "~/Repos/cursor/plugins/pstack"
      },
      "compatibilitySkill": "pstack-claude",
      "baselineScope": "Local manual setup. The configured Skills revision does not include pstack-claude; replica setup does not supply that helper.",
      "preflight": [
        "claude plugin marketplace list --json",
        "claude plugin list --json",
        "claude plugin validate .claude-plugin/marketplace.json --json"
      ],
      "verification": [
        "Confirm a fresh Claude Code or T3 Code session exposes the namespaced Pstack skills; plugin-manager listing alone does not establish picker behavior."
      ]
    }
  },
  "bareSkillOwners": {
    "tdd": "mattpocock/skills",
    "teach": "mattpocock/skills"
  }
}
